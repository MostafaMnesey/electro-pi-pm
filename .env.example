# ─── App Settings ──────────────────────────────────
PORT=
APP_PORT=
NODE_ENV=development

# ─── PostgreSQL ───────────────────────────────────
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
# Local development URL (outside Docker)
DATABASE_URL=postgresql://Pm_user2026:pm!2522@2026@localhost:5450/pm_db

# ─── Redis ───────────────────────────────────────
REDIS_PORT=
# Local development URL (outside Docker)
REDIS_URL=

# ─── pgAdmin ─────────────────────────────────────
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=
PGADMIN_PORT=

# ─── Security Settings ───────────────────────────
ENCRYPT_KEY=
SALT=
JWT_SECRET=
JWT_SECRET_ACCESS=
JWT_SECRET_REFRESH=

# ─── Rate Limiting ────────────────────────────────
# Global: applies to every API endpoint (anti-DDoS / spam)
# Window in milliseconds: 900000 = 15 minutes
GLOBAL_RATE_LIMIT_WINDOW_MS=
GLOBAL_RATE_LIMIT_MAX=

AUTH_RATE_LIMIT_WINDOW_MS=
AUTH_RATE_LIMIT_MAX=

# OTP: applies to /verify-account, /resend-otp, /forget-password, /reset-password
OTP_RATE_LIMIT_WINDOW_MS=
OTP_RATE_LIMIT_MAX=




# ─── CORS ────────────────────────────────────────
CORS_ORIGINS=
